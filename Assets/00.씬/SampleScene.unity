  pages:
  - screenshots:
    - {fileID: 21300000, guid: 2e3604a7f86131e40a4e387d8ce9c8d0, type: 3}
    - {fileID: 21300000, guid: 4789a85501188c647884bad634798e53, type: 3}
    titleText: "\uC544\uC774\uD15C \uC815\uBCF4\uB97C \uD655\uC778\uD558\uC138\uC694"
    explanationText: "\uC544\uC774\uD15C\uC744 \uC120\uD0DD\uD558\uBA74 \uC815\uBCF4\uCC3D\uC774
      \uC606\uC5D0 \uB098\uD0C0\uB0A9\uB2C8\uB2E4.\n\uB2E4\uC2DC \uD074\uB9AD\uD558\uBA74
      \uB2EB\uD600\uC694.\n\n\uC5B4\uB5A4 \uD6A8\uACFC\uAC00 \uC788\uB294\uC9C0 \uD655\uC778\uD574\uBCF4\uC138\uC694."
  - screenshots:
    - {fileID: 21300000, guid: 2e3604a7f86131e40a4e387d8ce9c8d0, type: 3}
    - {fileID: 21300000, guid: 0d2cf0a4836c710409428e6b442ebf63, type: 3}
    - {fileID: 21300000, guid: dd9c6a5e8b26858438e6cebf43810eea, type: 3}
    - {fileID: 21300000, guid: 28623a991763e7c4aaaba6c9c984dac6, type: 3}
    titleText: "\uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uBC30\uCE58\uD558\uC138\uC694"
    explanationText: "\uAC8C\uC784\uC744 \uC2DC\uC791\uD558\uBA74 \uBA3C\uC800 \uC9C0\uAE09\uBC1B\uC740
      \uC544\uC774\uD15C\uC744\n\uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uBC30\uCE58\uD574\uC57C
      \uD574\uC694.\n\n\uC544\uC774\uD15C\uC744 \uB4DC\uB798\uADF8\uD574\uC11C \uC6D0\uD558\uB294
      \uCE78\uC5D0 \uB193\uC73C\uBA74 \uB418\uACE0,\n\uD68C\uC804\uBC84\uD2BC\uC73C\uB85C
      \uBC29\uD5A5\uC744 \uBC14\uAFC0 \uC218\uB3C4 \uC788\uC5B4\uC694.\n\uBC30\uCE58\uAC00
      \uC644\uB8CC\uB418\uBA74 \uC778\uBCA4\uD1A0\uB9AC \uBC84\uD2BC\uC774 \uD65C\uC131\uD654\uB429\uB2C8\uB2E4."
  - screenshots:
    - {fileID: 21300000, guid: db308458ac8c7a84da730fafb9ca1833, type: 3}
    - {fileID: 21300000, guid: 8bf7815bc2f9b7d4aab344cecb0202e8, type: 3}
    - {fileID: 21300000, guid: 86da092f7a2088f4fbbff5842ea707b1, type: 3}
    titleText: "\uC0DD\uC874\uC744 \uC2DC\uC791\uD558\uC138\uC694"
    explanationText: "\uC801\uB4E4 \uC18D\uC5D0\uC11C \uCD5C\uB300\uD55C \uC624\uB798
      \uC0B4\uC544\uB0A8\uC73C\uC138\uC694.\n\n\uCE90\uB9AD\uD130\uB294 \uC790\uB3D9\uC73C\uB85C
      \uACF5\uACA9\uD558\uB2C8,\n\uC5EC\uB7EC\uBD84\uC740 \uC774\uB3D9\uC5D0\uB9CC
      \uC9D1\uC911\uD558\uBA74 \uB429\uB2C8\uB2E4."
  - screenshots:
    - {fileID: 21300000, guid: f36962a2633f61642b3a59bc5ff80db6, type: 3}
    - {fileID: 21300000, guid: c8e20843e0c42a94bac5b252e9a9c8bc, type: 3}
    - {fileID: 21300000, guid: 206c54874d9a2d74ab81bc9eb37f7896, type: 3}
    - {fileID: 21300000, guid: caa91d28b917c3b449dfed8054e40f55, type: 3}
    titleText: "\uACBD\uD5D8\uCE58\uB97C \uBAA8\uC544 \uBCF4\uC0C1\uC744 \uBC1B\uC73C\uC138\uC694"
    explanationText: "\uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uACBD\uD5D8\uCE58 \uAD6C\uC2AC\uC774
      \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4.\n\uAD6C\uC2AC\uC744 \uBAA8\uC544 \uB808\uBCA8\uC5C5\uD558\uBA74
      4\uAC00\uC9C0 \uBCF4\uC0C1 \uC911 \uD558\uB098\uB97C\n\uACE8\uB77C \uC2A4\uD0EF\uC744
      \uAC15\uD654\uD560 \uC218 \uC788\uC5B4\uC694. \n\uBCF4\uC0C1\uB9C8\uB2E4 \uB4F1\uAE09\uC774
      \uC788\uC5B4 \uB192\uC740 \uB4F1\uAE09\uC77C\uC218\uB85D\n\uB354 \uAC15\uB825\uD569\uB2C8\uB2E4.\n\uB9C8\uC74C\uC5D0
      \uB4DC\uB294 \uAC8C \uC5C6\uB2E4\uBA74 \uB9AC\uB864\uB85C \uB2E4\uC2DC \uBF51\uC544\uBCF4\uC138\uC694."
  - screenshots:
    - {fileID: 21300000, guid: 2e6a0d9e0cf0b5e429dabc94948f1457, type: 3}
    - {fileID: 21300000, guid: ffc707cd63a4e66499099839fb5d7ef4, type: 3}
    - {fileID: 21300000, guid: 70ff6712397ebb1408abe02d22d2e101, type: 3}
    - {fileID: 21300000, guid: 125be719efe59f64b953a665f83ee535, type: 3}
    - {fileID: 21300000, guid: 313b40a8c9e04f84b9eceb24cb4e68a2, type: 3}
    titleText: "\uC778\uBCA4\uD1A0\uB9AC\uAC00 \uB113\uC5B4\uC838\uC694"
    explanationText: "5\uB808\uBCA8\uB9C8\uB2E4 \uC778\uBCA4\uD1A0\uB9AC \uCE78\uC774
      \uD568\uAED8 \uB113\uC5B4\uC838,\n\uB354 \uB9CE\uC740 \uBB34\uAE30\uC640 \uC7A5\uBE44\uB97C
      \uCC59\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - screenshots:
    - {fileID: 21300000, guid: 6fc71b7ab3f6e6e4685893218fc2883c, type: 3}
    - {fileID: 21300000, guid: 740f632f038037e45bdb9d8498d78e32, type: 3}
    - {fileID: 21300000, guid: d22824a8b25896344be75e91c2d7479f, type: 3}
    titleText: "\uC9C0\uB3C4\uB85C \uBCF4\uAE09 \uC0C1\uC790\uB97C \uCC3E\uC544\uBCF4\uC138\uC694"
    explanationText: "\uC2DC\uC791 \uC9C0\uC810\uC5D0\uC11C \uBA40\uC5B4\uC9C8\uC218\uB85D
      \uB354 \uB9CE\uC740 \uBCF4\uAE09 \uC0C1\uC790\uAC00\n\uB4F1\uC7A5\uD569\uB2C8\uB2E4.\n\n\uC9C0\uB3C4\uB97C
      \uC5F4\uBA74 \uAC00\uAE4C\uC6B4 \uC0C1\uC790\uB294 \uC544\uC774\uCF58\uC73C\uB85C,\n\uBA3C
      \uC0C1\uC790\uB294 \uBC29\uD5A5 \uD654\uC0B4\uD45C\uB85C \uD45C\uC2DC\uB418\uB2C8
      \uCC38\uACE0\uD574\uC11C\n\uC774\uB3D9\uD574\uBCF4\uC138\uC694."
  - screenshots:
    - {fileID: 21300000, guid: f41a641521f8db349aabf4fccb1bfe49, type: 3}
    - {fileID: 21300000, guid: 34167eaf0e29a9d47afbc5c51d55467c, type: 3}
    - {fileID: 21300000, guid: 3ebb004150aabf147a50513c0b5a85b2, type: 3}
    titleText: "\uD6C4\uBCF4 \uC911 \uD558\uB098\uB9CC \uACE0\uB97C \uC218 \uC788\uC5B4\uC694"
    explanationText: "\uBCF4\uAE09 \uC0C1\uC790\uB97C \uC5F4\uBA74 \uBB34\uAE30\uB098
      \uC7A5\uBE44 \uD6C4\uBCF4 4\uAC1C\uAC00 \uB728\uBA70\n\uADF8\uC911 \uB531 \uD558\uB098\uB9CC
      \uC120\uD0DD\uD560 \uC218 \uC788\uC5B4\uC694.\n\n\uB9C8\uC74C\uC5D0 \uC548
      \uB4E4\uBA74 \uD55C \uBC88 \uB9AC\uB864\uD560 \uC218 \uC788\uACE0,\n\uACE0\uB978
      \uC544\uC774\uD15C\uC740 \uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uBC30\uCE58\uD574\uC57C\n\uD6A8\uACFC\uB97C
      \uBC1B\uC2B5\uB2C8\uB2E4."
  - screenshots:
    - {fileID: 21300000, guid: 0e8b80e63fe92694aa19241e98586fde, type: 3}
    - {fileID: 21300000, guid: db7238fd4e112b8429f39ae5ac1f9feb, type: 3}
    - {fileID: 21300000, guid: b317a33b209daf349a2587b34986f9dd, type: 3}
    titleText: "\uD544\uC694 \uC5C6\uB294 \uD6C4\uBCF4\uB294 \uBC84\uB9AC\uC138\uC694"
    explanationText: "\uD6C4\uBCF4 \uC544\uC774\uD15C\uC744 \uBC84\uB9AC\uAE30 \uAD6C\uC5ED\uC73C\uB85C
      \uB4DC\uB798\uADF8\uD558\uBA74\n\uD558\uB098\uC529 \uBC84\uB9B4 \uC218 \uC788\uC5B4\uC694.\n\uBC84\uB9AC\uAE30
      \uAD6C\uC5ED\uC744 \uAE38\uAC8C \uB204\uB974\uBA74 \uB0A8\uC740 \uD6C4\uBCF4\uB97C
      \uD55C \uBC88\uC5D0\n\uBAA8\uB450 \uBC84\uB9B4 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\n\uD6C4\uBCF4\uAC00
      \uD558\uB098\uB3C4 \uB0A8\uC9C0 \uC54A\uC544\uC57C \uC774 \uD654\uBA74\uC744
      \uB098\uAC08 \uC218\n\uC788\uC73C\uB2C8, \uC120\uD0DD\uD558\uAC70\uB098 \uBC84\uB824\uC11C
      \uBAA8\uB450 \uC815\uB9AC\uD574\uC8FC\uC138\uC694."
  - screenshots:
    - {fileID: 21300000, guid: 2f2b56f70b01dfb43a91ef7a74e132a7, type: 3}
    - {fileID: 21300000, guid: 36020c0b301b62141a65fa6c03cd924c, type: 3}
    titleText: "\uD3EC\uD0C8\uC744 \uD65C\uC6A9\uD574\uBCF4\uC138\uC694"
    explanationText: "\uBCF4\uAE09 \uC0C1\uC790\uAC00 \uBC18\uB300\uD3B8 \uBA40\uB9AC
      \uC788\uC744 \uB54C \uD3EC\uD0C8\uB85C \uBE60\uB974\uAC8C\n\uC911\uC559\uC73C\uB85C
      \uC774\uB3D9\uD560 \uC218 \uC788\uC5B4\uC694.\n\uB2E4\uB9CC \uC6CC\uD504 \uB3C4\uC911\uC5D0\uB294
      \uC870\uC791\uC774 \uB9C9\uD78C \uCC44\uB85C \uC2DC\uAC04\uC740\n\uACC4\uC18D
      \uD750\uB974\uAE30 \uB54C\uBB38\uC5D0, \uC704\uD5D8\uD560 \uB54C \uB3C4\uB9DD\uCE58\uB294\n\uC6A9\uB3C4\uB85C
      \uC4F0\uBA74 \uC624\uD788\uB824 \uB354 \uC704\uD5D8\uD560 \uC218 \uC788\uC5B4\uC694."
  - screenshots:
    - {fileID: 21300000, guid: 5c51dd6ff67b2314dba7ff5e8f96e9d3, type: 3}
    - {fileID: 21300000, guid: 67056e2a5c7816c47ab86ab1661f94bf, type: 3}
    titleText: "\uC815\uC608 \uBAAC\uC2A4\uD130\uB97C \uC870\uC2EC\uD558\uC138\uC694"
    explanationText: "\uAC00\uB054 \uC740\uC740\uD55C \uD14C\uB450\uB9AC \uBE5B\uC744
      \uB0B4\uBFDC\uB294 \uC815\uC608 \uBAAC\uC2A4\uD130\uAC00 \uB4F1\uC7A5\uD569\uB2C8\uB2E4.\n\uC77C\uBC18
      \uBAAC\uC2A4\uD130\uBCF4\uB2E4 \uD6E8\uC52C \uAC15\uB825\uD558\uB2C8 \uD654\uB825\uACFC
      \uC7A5\uBE44\uB97C \uCDA9\uBD84\uD788 \uAC16\uCD98 \uB4A4 \uC0C1\uB300\uD558\uC138\uC694."
